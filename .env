# =========================================================
# PRODUCTION RECIPE TARGET CONFIGURATION
#
# DB53 = PLC recipe DB.
# Application writes only WORK POSITION values.
# HOME and SAFE positions are PLC-maintained.
#
# Production meaning:
# WORK POSITION 1 = Machine/Camera target
# WORK POSITION 2 = Laser target where required
#
# One physical servo axis can appear multiple times with different purpose.
# Example:
# Axis 5:
# - Sidewall 1 Camera FWD/REV Target -> DB53 Work Position 1
# - Sidewall 1 Laser FWD/REV Target  -> DB53 Work Position 2
# =========================================================

RECIPE_TARGET_COUNT=17


